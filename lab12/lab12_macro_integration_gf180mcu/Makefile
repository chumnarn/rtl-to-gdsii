SHELL := /usr/bin/env bash

LAB_ROOT := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))

PDK_ROOT ?= $(HOME)/.ciel
PDK ?= gf180mcuD
SCL ?= gf180mcu_fd_sc_mcu7t5v0
PDK_REVISION ?=

MACRO_RUN_TAG ?= macro_harden
TOP_RUN_TAG ?= macro_integration

.DEFAULT_GOAL := help

help: ## Show available commands
	@echo "Lab 12 Macro Integration — GF180MCU"
	@echo
	@echo "Usage:"
	@echo "  make <target> PDK_ROOT=... PDK=gf180mcuD SCL=gf180mcu_fd_sc_mcu7t5v0"
	@echo
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  %-18s %s\n", $$1, $$2}'

check: ## Check tools, PDK and configuration
	@PDK_ROOT="$(PDK_ROOT)" PDK="$(PDK)" SCL="$(SCL)" \
		./scripts/check_tools.sh
	@python3 ./scripts/preflight.py

install-pdk: ## Enable/install GF180MCU with ciel
	@command -v ciel >/dev/null 2>&1 || { echo "[ERROR] ciel not found"; exit 1; }
	@mkdir -p "$(PDK_ROOT)"
	@if [[ -n "$(PDK_REVISION)" ]]; then \
		ciel enable "$(PDK_REVISION)" \
			--pdk-root "$(PDK_ROOT)" \
			--pdk-family gf180mcu; \
	else \
		echo "[INFO] No PDK_REVISION supplied."; \
		echo "[INFO] Attempting to enable the default gf180mcu release."; \
		ciel enable gf180mcu \
			--pdk-root "$(PDK_ROOT)" \
			--pdk-family gf180mcu; \
	fi

macro: check ## Harden counter_macro from RTL to GDSII
	cd macro && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--scl "$(SCL)" \
		--pdk-root "$(PDK_ROOT)" \
		--run-tag "$(MACRO_RUN_TAG)" \
		--save-views-to final

collect: ## Collect macro GDS, LEF and netlist
	@MACRO_RUN_DIR="$(LAB_ROOT)/macro/runs/$(MACRO_RUN_TAG)" \
	 MACRO_FINAL_DIR="$(LAB_ROOT)/macro/final" \
	 DEST_DIR="$(LAB_ROOT)/macros/counter_macro" \
	 ./scripts/collect_macro_views.sh
	@python3 ./scripts/preflight.py --require-macro
	@./scripts/verify_macro_instance.sh views

top: check ## Integrate the hardened macro in macro_wrapper
	@python3 ./scripts/preflight.py --require-macro
	cd top && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--scl "$(SCL)" \
		--pdk-root "$(PDK_ROOT)" \
		--run-tag "$(TOP_RUN_TAG)" \
		--save-views-to final
	@TOP_RUN_DIR="$(LAB_ROOT)/top/runs/$(TOP_RUN_TAG)" \
		./scripts/verify_macro_instance.sh run

all: macro collect top ## Run complete two-stage hierarchical flow

summary: ## Show generated views and important report lines
	@MACRO_RUN_DIR="$(LAB_ROOT)/macro/runs/$(MACRO_RUN_TAG)" \
	 TOP_RUN_DIR="$(LAB_ROOT)/top/runs/$(TOP_RUN_TAG)" \
	 ./scripts/report_summary.sh

summary-macro: ## List files generated by macro hardening
	@find "macro/runs/$(MACRO_RUN_TAG)" -type f 2>/dev/null | sort || true

summary-top: ## List files generated by top integration
	@find "top/runs/$(TOP_RUN_TAG)" -type f 2>/dev/null | sort || true

open-macro: ## Open macro run in OpenROAD
	cd macro && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--scl "$(SCL)" \
		--pdk-root "$(PDK_ROOT)" \
		--run-tag "$(MACRO_RUN_TAG)" \
		--last-run \
		--flow OpenInOpenROAD

open-top: ## Open integrated top run in OpenROAD
	cd top && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--scl "$(SCL)" \
		--pdk-root "$(PDK_ROOT)" \
		--run-tag "$(TOP_RUN_TAG)" \
		--last-run \
		--flow OpenInOpenROAD

klayout-top: ## Open integrated top-level GDS in KLayout
	cd top && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--scl "$(SCL)" \
		--pdk-root "$(PDK_ROOT)" \
		--run-tag "$(TOP_RUN_TAG)" \
		--last-run \
		--flow OpenInKLayout

clean-runs: ## Delete LibreLane runs and exported final views
	rm -rf macro/runs macro/final top/runs top/final

clean-macro-views: ## Delete generated macro deliverables
	rm -rf macros/counter_macro/gds \
	       macros/counter_macro/lef \
	       macros/counter_macro/nl
	mkdir -p macros/counter_macro/gds \
	         macros/counter_macro/lef \
	         macros/counter_macro/nl

distclean: clean-runs clean-macro-views ## Delete all generated Lab output

.PHONY: help check install-pdk macro collect top all summary \
        summary-macro summary-top open-macro open-top klayout-top \
        clean-runs clean-macro-views distclean
