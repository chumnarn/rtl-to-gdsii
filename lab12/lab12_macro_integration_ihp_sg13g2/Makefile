SHELL := /usr/bin/env bash

LAB_ROOT := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))

PDK_ROOT ?= $(LAB_ROOT)/IHP-Open-PDK
PDK ?= ihp-sg13g2
PDK_COMMIT ?= 3b5a704ba6738aa686b08706187830e6284d2a10

MACRO_RUN_TAG ?= macro_harden
TOP_RUN_TAG ?= macro_integration

MACRO_CONFIG := $(LAB_ROOT)/macro/config.yaml
TOP_CONFIG := $(LAB_ROOT)/top/config.yaml

.DEFAULT_GOAL := help

help: ## Show available commands
	@echo "Lab 12 Macro Integration — IHP SG13G2"
	@echo
	@echo "Usage: make <target> [PDK_ROOT=...] [MACRO_RUN_TAG=...] [TOP_RUN_TAG=...]"
	@echo
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  %-18s %s\n", $$1, $$2}'

check: ## Check tools, PDK and configuration files
	@PDK_ROOT="$(PDK_ROOT)" PDK="$(PDK)" ./scripts/check_tools.sh
	@python3 ./scripts/preflight.py

clone-pdk: ## Install/enable the pinned IHP PDK with ciel
	@command -v ciel >/dev/null 2>&1 || { echo "[ERROR] ciel not found"; exit 1; }
	@mkdir -p "$(PDK_ROOT)"
	ciel enable "$(PDK_COMMIT)" \
		--pdk-root "$(PDK_ROOT)" \
		--pdk-family "$(PDK)"

macro: check ## Harden counter_macro from RTL to GDSII
	cd macro && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--pdk-root "$(PDK_ROOT)" \
		--manual-pdk \
		--run-tag "$(MACRO_RUN_TAG)" \
		--save-views-to final

collect: ## Collect hardened macro LEF/GDS/netlist into macros/
	@MACRO_RUN_DIR="$(LAB_ROOT)/macro/runs/$(MACRO_RUN_TAG)" \
	 MACRO_FINAL_DIR="$(LAB_ROOT)/macro/final" \
	 DEST_DIR="$(LAB_ROOT)/macros/counter_macro" \
	 ./scripts/collect_macro_views.sh
	@python3 ./scripts/preflight.py --require-macro
	@./scripts/verify_macro_instance.sh views

top: check ## Integrate the collected macro into macro_wrapper
	@python3 ./scripts/preflight.py --require-macro
	cd top && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--pdk-root "$(PDK_ROOT)" \
		--manual-pdk \
		--run-tag "$(TOP_RUN_TAG)" \
		--save-views-to final
	@TOP_RUN_DIR="$(LAB_ROOT)/top/runs/$(TOP_RUN_TAG)" \
	 ./scripts/verify_macro_instance.sh run

all: macro collect top ## Run macro hardening and top-level integration

summary: ## Print important reports and output paths
	@MACRO_RUN_DIR="$(LAB_ROOT)/macro/runs/$(MACRO_RUN_TAG)" \
	 TOP_RUN_DIR="$(LAB_ROOT)/top/runs/$(TOP_RUN_TAG)" \
	 ./scripts/report_summary.sh

summary-macro: ## List files generated by the macro run
	@find "macro/runs/$(MACRO_RUN_TAG)" -type f 2>/dev/null | sort || true

summary-top: ## List files generated by the top-level run
	@find "top/runs/$(TOP_RUN_TAG)" -type f 2>/dev/null | sort || true

open-macro: ## Open the last/specified macro run in OpenROAD
	cd macro && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--pdk-root "$(PDK_ROOT)" \
		--manual-pdk \
		--run-tag "$(MACRO_RUN_TAG)" \
		--last-run \
		--flow OpenInOpenROAD

open-top: ## Open the last/specified top run in OpenROAD
	cd top && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--pdk-root "$(PDK_ROOT)" \
		--manual-pdk \
		--run-tag "$(TOP_RUN_TAG)" \
		--last-run \
		--flow OpenInOpenROAD

klayout-top: ## Open integrated top-level GDS in KLayout
	cd top && \
	librelane config.yaml \
		--pdk "$(PDK)" \
		--pdk-root "$(PDK_ROOT)" \
		--manual-pdk \
		--run-tag "$(TOP_RUN_TAG)" \
		--last-run \
		--flow OpenInKLayout

clean-runs: ## Remove LibreLane runs and final views
	rm -rf macro/runs macro/final top/runs top/final

clean-macro-views: ## Remove collected generated macro views
	rm -rf macros/counter_macro/gds \
	       macros/counter_macro/lef \
	       macros/counter_macro/nl
	mkdir -p macros/counter_macro/gds \
	         macros/counter_macro/lef \
	         macros/counter_macro/nl

distclean: clean-runs clean-macro-views ## Remove all generated data except the PDK

.PHONY: help check clone-pdk macro collect top all summary \
        summary-macro summary-top open-macro open-top klayout-top \
        clean-runs clean-macro-views distclean
